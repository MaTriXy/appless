# Serializer key order is NOT a flat code-unit sort.
#
# lib/serialize.mjs does Object.keys(v).sort() and re-inserts into a fresh
# plain object, but the bytes come from JSON.stringify, which re-derives the
# order from OrdinaryOwnPropertyKeys: every CANONICAL ARRAY INDEX ("0" ..
# "4294967294", i.e. ToString(ToUint32(k)) === k) is emitted first in ascending
# NUMERIC order, and only then the remaining keys in insertion (= sorted)
# order. So "10" follows "2", and "4294967295" is demoted to the string group
# because it is out of array-index range.
#
# Exercised in both key-sorting paths: a plain-object KVList row (props) and a
# $state declaration.
$idx = {"-dash": 1, "10": 2, "2": 3, "alpha": 4, " space": 5, "": 6, "+plus": 7, "0": 8, "$usd": 9, "(paren)": 10, "4294967294": 11, "4294967295": 12}
root = Card([
  CardHeader("Index-key hoisting"),
  KVList([
    {"-dash": 1, "10": 2, "2": 3, "alpha": 4, " space": 5, "": 6, "+plus": 7, "0": 8, "$usd": 9, "(paren)": 10, "4294967294": 11, "4294967295": 12},
    {"007": "a", "01": "b", "1.5": "c", "-0": "d", " 1": "e", "9": "f", "1e2": "g"},
    {label: "plain", value: "row"}
  ], "IDX"),
  TextContent("two=" + $idx.2)
])
