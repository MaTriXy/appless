nums = [3, 1, 4, 1, 5, 9]
root = Card([
  CardHeader("Builtins"),
  KVList([
    {label: "count", value: "" + @Count(nums)},
    {label: "sum", value: "" + @Sum(nums)},
    {label: "avg", value: "" + @Avg(nums)},
    {label: "min", value: "" + @Min(nums)},
    {label: "max", value: "" + @Max(nums)},
    {label: "round", value: "" + @Round(3.14159, 2)},
    {label: "abs", value: "" + @Abs(-7)},
    {label: "floor", value: "" + @Floor(2.9)},
    {label: "ceil", value: "" + @Ceil(2.1)}
  ], "RESULTS")
])
