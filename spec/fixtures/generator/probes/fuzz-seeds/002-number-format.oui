root = Card([
  CardHeader("Number formatting"),
  KVList([
    {label: "e21", value: 1e21},
    {label: "e-7", value: 1e-7},
    {label: "e-6", value: 0.000001},
    {label: "tenth", value: 0.1},
    {label: "third", value: 1 / 3},
    {label: "maxsafe", value: 9007199254740991},
    {label: "overmax", value: 9007199254740993},
    {label: "negzero", value: 0 - 0},
    {label: "div0", value: 1 / 0},
    {label: "negdiv0", value: -1 / 0},
    {label: "nan", value: 0 / 0},
    {label: "big", value: 123456789012345678901234567890},
    {label: "small", value: 5e-324},
    {label: "str-e21", value: "" + 1e21},
    {label: "str-third", value: "" + (1 / 3)},
    {label: "str-nan", value: "" + (0 / 0)}
  ], "NUMBERS")
])
