{
  "name": "openui-fixture-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Golden-fixture oracle: generates expected parse trees from the real @openuidev/lang-core parser.",
  "scripts": {
    "postinstall": "node apply-patch.mjs",
    "generate": "node generate.mjs",
    "test": "node test.mjs && npm run check:streaming",
    "check:streaming": "node probes/regen-streaming-expectations.mjs --check ../../../ios/Packages/OpenUILang/Tests/OpenUILangTests/StreamingSemanticsTests.swift"
  },
  "dependencies": {
    "@openuidev/react-lang": "0.1.5",
    "esbuild": "^0.25.0",
    "patch-package": "^8.0.1",
    "zod": "^4.4.3"
  }
}
